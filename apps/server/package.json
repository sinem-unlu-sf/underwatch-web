{
  "name": "@kw/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --clear-screen=false src/index.ts",
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "seed:fixtures": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/scripts/seed-fixtures.ts",
    "demo:reset": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/scripts/demo-reset.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@kw/adapter-claude-code": "workspace:*",
    "@kw/analysis": "workspace:*",
    "@kw/graph": "workspace:*",
    "@kw/inference": "workspace:^",
    "@kw/observer-tetragon": "workspace:*",
    "@kw/redaction": "workspace:^",
    "@kw/schema": "workspace:*",
    "diff": "^8",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
